<?xml version="1.0" encoding="UTF-8"?>
<!--changelog - instructions on how the database is structured.-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="First trial" author="Anastassija Rozko">
        <createTable tableName="employee">
            <column name="id" type="serial">
                <constraints primaryKey="true" unique="true" nullable="false" />
            </column>
            <column name="first_name" type="text">
                <constraints nullable="false" />
            </column>
            <column name="last_name" type="text">
                <constraints nullable="false" />
            </column>
            <column name="email" type="text">
                <constraints unique="true" nullable="false" />
            </column>
            <column name="company" type="text">
                <constraints nullable="false" />
            </column>
        </createTable>

        <insert tableName="employee">
            <column name="first_name" value="Ago" />
            <column name="last_name" value="Luberg" />
            <column name="email" value="ago.luberg@taltech.ee" />
            <column name="company" value="TalTech" />
        </insert>
    </changeSet>
</databaseChangeLog>
